# ============================================================
# COMPANYLENS - ENVIRONMENT CONFIGURATION
# ============================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://companylens:companylens_secret@localhost:5432/companylens_db
POSTGRES_SERVER=localhost
POSTGRES_USER=companylens
POSTGRES_PASSWORD=companylens_secret
POSTGRES_DB=companylens_db
POSTGRES_PORT=5432

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Security & Auth
SECRET_KEY=companylens_production_secure_jwt_secret_key_change_me_in_prod
NEXTAUTH_SECRET=companylens_nextauth_secure_secret_token_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false

# Operation Mode: 'development' | 'mock' | 'production'
DATA_MODE=development

# Authorized GST Provider / GSP Configuration
# Note: In production, configure with your licensed GSP / GSTN credentials
GST_PROVIDER_BASE_URL=https://api.gstprovider.authorized.in/v1
GST_PROVIDER_CLIENT_ID=gst_client_id_placeholder
GST_PROVIDER_CLIENT_SECRET=gst_client_secret_placeholder
GST_PROVIDER_API_KEY=gst_api_key_placeholder

# Authorized PAN Verification Provider Configuration
# Note: Handled via approved agency endpoint (e.g. NSDL / UTIITSL / authorized aggregator)
PAN_PROVIDER_BASE_URL=https://api.panverify.authorized.in/v1
PAN_PROVIDER_CLIENT_ID=pan_client_id_placeholder
PAN_PROVIDER_CLIENT_SECRET=pan_client_secret_placeholder
PAN_PROVIDER_API_KEY=pan_api_key_placeholder

# MCA Open Government Data Source URL
MCA_DATA_SOURCE_URL=https://data.gov.in/catalog/company-master-data

# Licensed Financial Data Provider Configuration
# Leave blank or unconfigured to demonstrate graceful "Financial data unavailable from connected sources"
FINANCIAL_PROVIDER_BASE_URL=https://api.financialdata.licensed.in/v1
FINANCIAL_PROVIDER_API_KEY=financial_provider_key_placeholder

# Observability
SENTRY_DSN=

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
